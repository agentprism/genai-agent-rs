{
  "schemaVersion": 1,
  "method": "POST",
  "path": "/responses",
  "headers": {
    "accept": "application/json",
    "api-key": "[REDACTED]",
    "content-type": "application/json",
    "x-fixture-model": "model-value",
    "x-fixture-request": "request-value"
  },
  "omittedRuntimeHeaders": [
    "accept-encoding",
    "connection",
    "content-length",
    "host",
    "user-agent",
    "x-stainless-arch",
    "x-stainless-lang",
    "x-stainless-os",
    "x-stainless-package-version",
    "x-stainless-retry-count",
    "x-stainless-runtime",
    "x-stainless-runtime-version",
    "x-stainless-timeout"
  ]
}
