{
  "name": "pi-m4-fixture-capture",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "bun run capture.ts",
    "capture:openrouter-images": "bun run capture-openrouter-images.ts",
    "capture:openrouter-images:live": "PI_FIXTURE_OPENROUTER_IMAGES_LIVE=1 bun run capture-openrouter-images.ts",
    "capture:credential": "PI_FIXTURE_CAPTURE_MODE=credential-backed bun run capture.ts",
    "capture:credential-replay": "PI_FIXTURE_CAPTURE_MODE=credential-replay bun run capture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@aws-sdk/client-bedrock-runtime": "3.1048.0",
    "@google/genai": "1.52.0",
    "@smithy/node-http-handler": "4.7.3",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "openai": "6.40.0",
    "partial-json": "0.1.7"
  }
}
